# Copy to .env and fill in the key. Both are OpenAI-compatible endpoints.

# The model that writes the sketches, judges them and rewrites them.
INFERENCE_URL=http://localhost:8080/v1
INFERENCE_MODEL=mlx-community/Qwen3.8-27B-4bit
INFERENCE_API_KEY=

# A vision model that describes what each sketch drew, for the one above to judge and build on.
EYES_URL=http://localhost:11434/v1
EYES_MODEL=qwen2.5vl:7b
# EYES_API_KEY=

# How the tree grows: best score first (the default), or BFS.
# METHOD=BFS
